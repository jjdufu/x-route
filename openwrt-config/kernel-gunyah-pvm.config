# ==============================================================================
# x-route: OnePlus 13 (Snapdragon 8 Elite / SM8750) Gunyah pVM & QEMU Kernel Config
# Target: ImmortalWrt 24.10 (Linux 6.6) - target/linux/armsr/armv8/config-6.6
# ==============================================================================

# --- 1. Qualcomm Gunyah Protected VM (pVM) Critical DMA Pool Support ---
# 极其重要：一加 13 的 /dev/gunyah 强制启用 Protected VM 内存借出保护。
# 必须启用 CONFIG_DMA_RESTRICTED_POOL 與 CONFIG_SWIOTLB，使 VirtIO 设备通过受限共享
# DMA 缓冲区与宿主机 crosvm 通信，否则挂载磁盘/网卡瞬间会触发宿主机 900E 黑屏死机！
CONFIG_SWIOTLB=y
CONFIG_DMA_RESTRICTED_POOL=y
CONFIG_VIRTIO_DMA_SHARED_BUFFER=y

# --- 2. Core VirtIO Bus & Device Drivers (Built-in for Instant Boot) ---
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_PCI_LIB=y
CONFIG_VIRTIO_PCI_LEGACY=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES=y
CONFIG_VIRTIO_BLK=y
CONFIG_BLK_MQ_VIRTIO=y
CONFIG_SCSI_VIRTIO=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_BALLOON=y
CONFIG_HW_RANDOM_VIRTIO=y

# --- 3. Host Storage Passthrough (/data/media/0/NAS -> /mnt/nas) ---
# 同时内置支持 crosvm 的 virtio-fs (高速推荐) 与 QEMU/crosvm 的 virtio-9p
CONFIG_FUSE_FS=y
CONFIG_VIRTIO_FS=y
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_9P_FS=y
CONFIG_9P_FS_POSIX_ACL=y
CONFIG_9P_FS_SECURITY=y

# --- 4. Dual Hypervisor Serial Console Support ---
# crosvm (Gunyah) 默认使用 8250 UART (ttyS0)，QEMU (-M virt) 默认使用 PL011 (ttyAMA0)
# 两者全部内置，确保同一份 Image 内核在双引擎下均可输出控制台日志并登录
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_PCI=y
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_HVC_DRIVER=y

# --- 5. Network Tunneling & Netfilter Built-ins ---
CONFIG_TUN=y
CONFIG_BRIDGE=y
CONFIG_NETFILTER=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y

# --- 6. Strip Unneeded Graphics / Audio Subsystem from VM Kernel ---
# CONFIG_DRM is not set
# CONFIG_DRM_VIRTIO_GPU is not set
# CONFIG_SOUND is not set
