#!/bin/sh /etc/rc.common
# ==============================================================================
# x-route-nas: Host Shared Storage (/data/media/0/NAS -> /mnt/nas) Auto-Mounter
# Automatically detects and mounts 'host_nas' via virtiofs (crosvm) or 9p (QEMU).
# ==============================================================================

START=95
STOP=10

MOUNT_POINT="/mnt/nas"
MOUNT_TAG="host_nas"

start() {
    mkdir -p "$MOUNT_POINT"

    if mountpoint -q "$MOUNT_POINT" 2>/dev/null; then
        logger -t x-route-nas "$MOUNT_POINT is already mounted."
        return 0
    fi

    # 1. Try virtiofs first (preferred high-speed channel under crosvm Gunyah)
    if grep -q "virtiofs" /proc/filesystems 2>/dev/null; then
        if mount -t virtiofs "$MOUNT_TAG" "$MOUNT_POINT" 2>/dev/null; then
            logger -t x-route-nas "Mounted $MOUNT_TAG on $MOUNT_POINT via virtiofs."
            return 0
        fi
    fi

    # 2. Fallback to 9p (virtio-9p under QEMU or crosvm p9)
    if grep -q "9p" /proc/filesystems 2>/dev/null; then
        if mount -t 9p -o trans=virtio,version=9p2000.L,rw,msize=524288,noatime "$MOUNT_TAG" "$MOUNT_POINT" 2>/dev/null; then
            logger -t x-route-nas "Mounted $MOUNT_TAG on $MOUNT_POINT via virtio-9p."
            return 0
        fi
    fi

    logger -t x-route-nas "No host_nas VirtFS tag attached (optional NAS passthrough inactive)."
    return 0
}

stop() {
    if mountpoint -q "$MOUNT_POINT" 2>/dev/null; then
        umount -l "$MOUNT_POINT" 2>/dev/null
    fi
}
