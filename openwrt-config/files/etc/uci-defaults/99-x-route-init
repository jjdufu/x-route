#!/bin/sh
# ==============================================================================
# x-route: OpenWrt First-Boot UCI Initialization Script
# Automatically configures WAN (172.16.1.2/24), LAN (192.168.100.1/24),
# DHCP/DNS, OpenVPN Firewall Zone (tun+), Serial Consoles, and NAS Mount Service.
# ==============================================================================

# 1. System Base Settings (Hostname, Timezone, LuCI Language)
uci -q batch <<EOF
set system.@system[0].hostname='x-route'
set system.@system[0].timezone='CST-8'
set system.@system[0].zonename='Asia/Shanghai'
set luci.main.lang='zh_cn'
commit system
commit luci
EOF

# 2. Detect WAN / LAN Interfaces by Deterministic MAC Address
# WAN MAC: 52:54:00:12:34:56 (tap-wan)
# LAN MAC: 52:54:00:12:34:57 (tap-lan)
WAN_DEV="eth0"
LAN_DEV="eth1"
for netdev in /sys/class/net/*; do
    devname="$(basename "$netdev")"
    [ "$devname" = "lo" ] && continue
    mac="$(cat "$netdev/address" 2>/dev/null | tr 'A-F' 'a-f')"
    case "$mac" in
        "52:54:00:12:34:56") WAN_DEV="$devname" ;;
        "52:54:00:12:34:57") LAN_DEV="$devname" ;;
    esac
done

# 3. Configure Network (Fixed LAN: 192.168.100.1/24, Fixed WAN: 172.16.1.2/24)
uci -q batch <<EOF
delete network.wan6
set network.br_lan=device
set network.br_lan.name='br-lan'
set network.br_lan.type='bridge'
delete network.br_lan.ports
add_list network.br_lan.ports='${LAN_DEV}'

set network.lan=interface
set network.lan.device='br-lan'
set network.lan.proto='static'
set network.lan.ipaddr='192.168.100.1'
set network.lan.netmask='255.255.255.0'
set network.lan.ip6assign='60'

set network.wan=interface
set network.wan.device='${WAN_DEV}'
set network.wan.proto='static'
set network.wan.ipaddr='172.16.1.2'
set network.wan.netmask='255.255.255.0'
set network.wan.gateway='172.16.1.1'
delete network.wan.dns
add_list network.wan.dns='223.5.5.5'
add_list network.wan.dns='119.29.29.29'
add_list network.wan.dns='1.1.1.1'
commit network
EOF

# 4. Configure DHCP & DNS (Force DHCP on br-lan, Gateway/DNS = 192.168.100.1)
uci -q batch <<EOF
set dhcp.lan.interface='lan'
set dhcp.lan.start='100'
set dhcp.lan.limit='150'
set dhcp.lan.leasetime='12h'
set dhcp.lan.force='1'
set dhcp.lan.dhcpv4='server'
delete dhcp.lan.dhcp_option
add_list dhcp.lan.dhcp_option='3,192.168.100.1'
add_list dhcp.lan.dhcp_option='6,192.168.100.1'
set dhcp.@dnsmasq[0].rebind_protection='0'
set dhcp.@dnsmasq[0].nonwildcard='0'
set dhcp.@dnsmasq[0].localservice='0'
commit dhcp
EOF

# 5. Configure Firewall & Pre-create OpenVPN (tun+) Site-to-Site Mesh Zone
uci -q batch <<EOF
set firewall.@defaults[0].syn_flood='1'
set firewall.@defaults[0].input='ACCEPT'
set firewall.@defaults[0].output='ACCEPT'
set firewall.@defaults[0].forward='ACCEPT'
set firewall.@defaults[0].flow_offloading='0'

# Ensure WAN zone has Masquerade and MSS Clamping enabled
set firewall.@zone[1].masq='1'
set firewall.@zone[1].mtu_fix='1'

# Create dedicated VPN zone for OpenVPN (tun+) with bidirectional LAN <-> VPN forwarding
delete firewall.vpn
set firewall.vpn=zone
set firewall.vpn.name='vpn'
set firewall.vpn.input='ACCEPT'
set firewall.vpn.output='ACCEPT'
set firewall.vpn.forward='ACCEPT'
set firewall.vpn.masq='1'
set firewall.vpn.mtu_fix='1'
add_list firewall.vpn.device='tun+'

delete firewall.lan_vpn
set firewall.lan_vpn=forwarding
set firewall.lan_vpn.src='lan'
set firewall.lan_vpn.dest='vpn'

delete firewall.vpn_lan
set firewall.vpn_lan=forwarding
set firewall.vpn_lan.src='vpn'
set firewall.vpn_lan.dest='lan'

commit firewall
EOF

# 6. Enable Both ttyS0 (crosvm Gunyah) and ttyAMA0 (QEMU) Serial Consoles
if [ -f /etc/inittab ]; then
    grep -q "^ttyS0:" /etc/inittab || echo "ttyS0::askfirst:/usr/libexec/login.sh" >> /etc/inittab
    grep -q "^ttyAMA0:" /etc/inittab || echo "ttyAMA0::askfirst:/usr/libexec/login.sh" >> /etc/inittab
    grep -q "^hvc0:" /etc/inittab || echo "hvc0::askfirst:/usr/libexec/login.sh" >> /etc/inittab
fi

# 7. Create /mnt/nas Mount Point & Enable x-route Services
mkdir -p /mnt/nas
[ -x /etc/init.d/x-route-netmap ] && /etc/init.d/x-route-netmap enable
[ -x /etc/init.d/x-route-nas ] && /etc/init.d/x-route-nas enable

exit 0
