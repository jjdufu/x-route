#!/sbin/sh
# ==============================================================================
# Standard KernelSU / SuKiSU / Magisk Module Installer (update-binary)
# ==============================================================================
umask 022

OUTFD=$2
ZIPFILE=$3
MODID="x_route"
MODPATH="/data/adb/modules_update/${MODID}"

ui_print() {
    if [ -n "${OUTFD:-}" ] && [ -e "/proc/self/fd/${OUTFD}" ]; then
        echo "ui_print $1" > "/proc/self/fd/${OUTFD}"
        echo "ui_print" > "/proc/self/fd/${OUTFD}"
    else
        echo "$1"
    fi
}

abort() {
    ui_print "$1"
    rm -rf "${MODPATH}"
    exit 1
}

set_perm() {
    chown "$2:$3" "$1" || return 1
    chmod "$4" "$1" || return 1
    local CON="${5:-u:object_r:system_file:s0}"
    chcon "${CON}" "$1" 2>/dev/null || true
}

set_perm_recursive() {
    find "$1" -type d 2>/dev/null | while read -r dir; do
        set_perm "$dir" "$2" "$3" "$4" "${6:-}"
    done
    find "$1" -type f -o -type l 2>/dev/null | while read -r file; do
        set_perm "$file" "$2" "$3" "$5" "${6:-}"
    done
}

ARCH="$(getprop ro.product.cpu.abi)"
case "${ARCH}" in
    arm64*) ARCH="arm64" ;;
    armeabi*) ARCH="arm" ;;
    x86_64*) ARCH="x64" ;;
    x86*) ARCH="x86" ;;
esac

mkdir -p "${MODPATH}"
unzip -o "${ZIPFILE}" -x 'META-INF/*' -d "${MODPATH}" >&2

if [ -f "${MODPATH}/customize.sh" ]; then
    # shellcheck disable=SC1090
    . "${MODPATH}/customize.sh"
fi

# If installed outside KSU/Magisk update mechanism, sync directly to /data/adb/modules
if [ ! -d "/data/adb/modules_update" ] || [ -z "${KSU:-}" ]; then
    mkdir -p "/data/adb/modules"
    rm -rf "/data/adb/modules/${MODID}"
    mv -f "${MODPATH}" "/data/adb/modules/${MODID}"
else
    mkdir -p "/data/adb/modules/${MODID}"
    touch "/data/adb/modules/${MODID}/update"
    cp -af "${MODPATH}/module.prop" "/data/adb/modules/${MODID}/module.prop"
    chmod 0644 "/data/adb/modules/${MODID}/module.prop"
fi

sync
exit 0
