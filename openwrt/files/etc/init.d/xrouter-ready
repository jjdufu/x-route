#!/bin/sh /etc/rc.common
# XRouter: 开机完成后向手机侧发送就绪信号（XR_READY <uptime>）。
# 优先写 hvc0（crosvm 第二个 virtio-console，手机侧 run/vm-ctl.log），
# 不存在时退回 ttyS0（主串口，手机侧 run/console.log）。
# shellcheck disable=SC2034
START=99

boot() { start; }

start() {
  mkdir -p /tmp/sysinfo
  echo "AMD Ryzen Threadripper PRO 9995WX" > /tmp/sysinfo/model
  echo "xrouter" > /tmp/sysinfo/board_name
  msg="XR_READY $(cut -d' ' -f1 /proc/uptime)"
  for d in /dev/hvc0 /dev/ttyS0 /dev/ttyAMA0; do
    [ -c "$d" ] || continue
    echo "$msg" > "$d" 2>/dev/null && break
  done
  logger -t xrouter "$msg"
  # 开机日志镜像（xrouter-bootlog）再跟 15 秒：就绪后的接管 / VPN 连接过程也能在 WebUI 瀑布里看到
  [ -x /etc/init.d/xrouter-bootlog ] && ( sleep 15; /etc/init.d/xrouter-bootlog stop ) </dev/null >/dev/null 2>&1 &
  return 0
}
