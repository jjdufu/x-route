#!/bin/sh /etc/rc.common
# XRouter: 按 cmdline 的 xr.share=ro|rw 挂载手机共享目录（virtiofs 标签 xrshare）到 /mnt/sdcard。
# shellcheck disable=SC2034
START=21
# shellcheck disable=SC2034
STOP=89

boot() { start; }

start() {
  mode="$(sed -n 's/.*[[:space:]]xr.share=\([a-z]*\).*/\1/p' /proc/cmdline)"
  case "$mode" in ro|rw) ;; *) return 0 ;; esac
  grep -qw virtiofs /proc/filesystems || return 0
  mkdir -p /mnt/sdcard
  grep -q ' /mnt/sdcard ' /proc/mounts || mount -t virtiofs -o "$mode" xrshare /mnt/sdcard
}

stop() { umount /mnt/sdcard 2>/dev/null; return 0; }
