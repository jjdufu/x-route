#!/bin/sh /etc/rc.common
# XRouter: 挂载主机控制目录（控制通道）：启用 OpenVPN 配置并把实际路由写回主机；
#          执行 IPv6 开关（host/ipv6.cmd）并上报实际状态（guest/ipv6）；
#          按 host/diag.cmd 生成网络快照（guest/diag.txt，已脱敏）；
#          按 host/hotspot.cmd 接管 / 交还热点网段（guest/hotspot 上报状态）；
#          按 host/mtu 让 eth0 跟随手机上游 MTU（guest/mtu 上报实际值），全部 tun* 按上游 MTU 扣封装开销；
#          按 host/time 跟手机对时；按 host/acct.cmd 输出手机 / 热点分来源流量（guest/acct）。
# shellcheck disable=SC2034
START=21
STOP=15

CTL=/var/run/xrouter

refresh_routes() { /usr/libexec/xrouter-vpnstat; }

# 隧道增减（新连上 / 断开 / 多份配置各自起停）时按上游 MTU 重算全部 tun* 的 MTU 与 MSS
tun_sig() { for d in /sys/class/net/tun*; do [ -d "$d" ] && printf '%s ' "${d##*/}"; done; }

# 虚拟机时钟跟手机对时：手机侧经 host/time 下发当前时间（开机时还有 cmdline xr.time）。
# 文件写下到这里读到有几秒延迟：本机落后才往前拨，超前 30 秒以上（时钟跑飞）才往回拨。
sync_time() {
  t="$({ tr -dc '0-9' < "${CTL}/host/time"; } 2>/dev/null)"
  [ -n "$t" ] || return 0
  now="$(date +%s)"
  if [ "$now" -lt "$((t - 1))" ] || [ "$now" -gt "$((t + 30))" ]; then
    date -s "@${t}" >/dev/null 2>&1 && logger -t xrouter "时钟跟随手机：${now} -> ${t}"
  fi
}

install_ovpn() {
  src="${CTL}/host/openvpn.ovpn"
  [ -s "$src" ] || return 1
  mkdir -p /etc/openvpn
  cp -f "$src" /etc/openvpn/xrouter.ovpn
  cat > /etc/openvpn/xrouter.conf <<'C'
config /etc/openvpn/xrouter.ovpn
script-security 2
up /etc/openvpn/xrouter-up.sh
down /etc/openvpn/xrouter-down.sh
route-up /etc/openvpn/xrouter-up.sh
C
  # 性能（写在用户配置之后，同名选项以此为准；不改加密协商，不影响单文件无密码 .ovpn）：
  #   OpenVPN 2.6 默认协商 AES-256-GCM / AES-128-GCM / ChaCha20，OpenSSL 走 ARMv8 AES 指令（硬件加速）；
  #   收发缓冲 512KB（sysctl 已放宽 rmem_max / wmem_max），UDP 下 fast-io 少一次 poll，tun 发送队列 500。
  #   MTU / MSS 不写死：由 xrouter-tunmtu 按上游 MTU 动态设置内核 tun 网卡与 nft MSS 钳制。
  grep -qE '^[[:space:]]*sndbuf[[:space:]]' "$src" || echo "sndbuf 524288" >> /etc/openvpn/xrouter.conf
  grep -qE '^[[:space:]]*rcvbuf[[:space:]]' "$src" || echo "rcvbuf 524288" >> /etc/openvpn/xrouter.conf
  grep -qE '^[[:space:]]*txqueuelen[[:space:]]' "$src" || echo "txqueuelen 500" >> /etc/openvpn/xrouter.conf
  grep -qiE '^[[:space:]]*(proto[[:space:]]+tcp|remote[[:space:]].*[[:space:]]tcp)' "$src" || echo "fast-io" >> /etc/openvpn/xrouter.conf
  uci -q set openvpn.xrouter=openvpn
  uci -q set openvpn.xrouter.enabled=1
  uci -q set openvpn.xrouter.config='/etc/openvpn/xrouter.conf'
  uci -q commit openvpn
  /etc/init.d/openvpn restart >/dev/null 2>&1
}

apply_cmd() {
  cmd="$(cat "${CTL}/host/openvpn.cmd" 2>/dev/null)"
  case "${cmd%% *}" in   # 命令后可带时间戳，同一命令重复下发也会执行
    enable|reload) install_ovpn ;;
    disable)
      uci -q set openvpn.xrouter.enabled=0
      uci -q commit openvpn
      /etc/init.d/openvpn stop >/dev/null 2>&1
      refresh_routes
      ;;
  esac
}

watch() {
  last=""; last6=""; lastwan=""; lastdiag=""; lasths=""; lastmtu=""; lasttun=""; lasttime=""; lastacct=""
  # 上报热点接管能力与状态（手机侧据此判断系统盘是否支持）
  /usr/libexec/xrouter-hotspot status > "${CTL}/guest/hotspot.tmp" && mv -f "${CTL}/guest/hotspot.tmp" "${CTL}/guest/hotspot"
  while :; do
    [ -d "$CTL" ] || exit 0
    cmd="$(cat "${CTL}/host/openvpn.cmd" 2>/dev/null)"
    if [ -n "$cmd" ] && [ "$cmd" != "$last" ]; then
      last="$cmd"
      apply_cmd
    fi
    c6="$(cat "${CTL}/host/ipv6.cmd" 2>/dev/null)"
    if [ -n "$c6" ] && [ "$c6" != "$last6" ]; then
      last6="$c6"
      /usr/libexec/xrouter-ipv6 "${c6%% *}"
    fi
    wan="$(cat "${CTL}/host/ipv6.wan" 2>/dev/null)"
    if [ "$wan" != "$lastwan" ]; then
      lastwan="$wan"
      /usr/libexec/xrouter-ipv6 wan
    fi
    /usr/libexec/xrouter-ipv6 state > "${CTL}/guest/ipv6.tmp" && mv -f "${CTL}/guest/ipv6.tmp" "${CTL}/guest/ipv6"
    hc="$(cat "${CTL}/host/hotspot.cmd" 2>/dev/null)"
    if [ -n "$hc" ] && [ "$hc" != "$lasths" ]; then
      lasths="$hc"
      # 末尾是时间戳，其余为 on <CIDR> [设备IP…] 或 off
      # shellcheck disable=SC2086
      set -- ${hc% *}
      /usr/libexec/xrouter-hotspot "$@"
      /usr/libexec/xrouter-hotspot status > "${CTL}/guest/hotspot.tmp" && mv -f "${CTL}/guest/hotspot.tmp" "${CTL}/guest/hotspot"
    fi
    mt="$(cat "${CTL}/host/mtu" 2>/dev/null)"
    if [ -n "$mt" ] && [ "$mt" != "$lastmtu" ]; then
      lastmtu="$mt"
      /usr/libexec/xrouter-mtu "$mt"
      cat /sys/class/net/eth0/mtu > "${CTL}/guest/mtu" 2>/dev/null
      /usr/libexec/xrouter-tunmtu apply
      [ -x /usr/libexec/xrouter-hotspot ] && /usr/libexec/xrouter-hotspot mtu
    fi
    ts="$(tun_sig)"
    if [ "$ts" != "$lasttun" ]; then
      lasttun="$ts"
      /usr/libexec/xrouter-tunmtu apply
    fi
    tm="$(cat "${CTL}/host/time" 2>/dev/null)"
    if [ -n "$tm" ] && [ "$tm" != "$lasttime" ]; then
      lasttime="$tm"
      sync_time
    fi
    # 分来源流量：手机侧写 host/acct.cmd="snap|reset <ts>"，这里输出计数到 guest/acct（首行回显 ts）
    ac="$(cat "${CTL}/host/acct.cmd" 2>/dev/null)"
    if [ -n "$ac" ] && [ "$ac" != "$lastacct" ]; then
      lastacct="$ac"
      [ "${ac%% *}" = reset ] && /usr/libexec/xrouter-acct reset
      { echo "ts=${ac#* }"; /usr/libexec/xrouter-acct show; } > "${CTL}/guest/acct.tmp" 2>/dev/null
      mv -f "${CTL}/guest/acct.tmp" "${CTL}/guest/acct"
    fi
    # 调试快照：手机侧写 host/diag.cmd="snap <ts>"，这里生成后整体替换 guest/diag.txt（首行回显 ts）
    dc="$(cat "${CTL}/host/diag.cmd" 2>/dev/null)"
    if [ -n "$dc" ] && [ "$dc" != "$lastdiag" ]; then
      lastdiag="$dc"
      { echo "ts=${dc#snap }"; /usr/libexec/xrouter-diag; } > "${CTL}/guest/diag.tmp" 2>&1
      mv -f "${CTL}/guest/diag.tmp" "${CTL}/guest/diag.txt"
    fi
    refresh_routes
    sleep 2
  done
}

boot() { start; }

start() {
  mkdir -p "$CTL"
  if grep -qw virtiofs /proc/filesystems; then
    mount -t virtiofs xrctl "$CTL" 2>/dev/null || true
  fi
  mkdir -p "${CTL}/host" "${CTL}/guest"
  chmod 0755 /etc/openvpn/xrouter-up.sh /etc/openvpn/xrouter-down.sh 2>/dev/null || true
  /usr/libexec/xrouter-ipv6 boot
  /usr/libexec/xrouter-acct init
  sync_time
  watch &
  echo $! > /var/run/xrouter-vpn.pid
}

stop() {
  p="$(cat /var/run/xrouter-vpn.pid 2>/dev/null)"
  [ -n "$p" ] && kill "$p" 2>/dev/null
  umount "$CTL" 2>/dev/null || true
  return 0
}
