#!/bin/sh /etc/rc.common
# XRouter: 启动 /dev/hvc1 内部代理，为手机端内嵌 zashboard 提供无 IP HTTP/WebSocket 与资源通道。
# shellcheck disable=SC2034
START=22
STOP=14
USE_PROCD=1

start_service() {
  [ -e /dev/hvc1 ] || return 0
  procd_open_instance
  procd_set_param command /usr/libexec/xrouter-clashd
  procd_set_param respawn 3600 5 5
  procd_set_param stderr 1
  procd_close_instance
}
