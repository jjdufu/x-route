#!/bin/sh
# XRouter: 首次开机执行一次。
# root 密码、ttyd、dropbear 全部保持上游默认（root 空密码），不做任何修改。

# 1. 系统（日志只在内存环形缓冲里，限 128KB，不写闪存；标记 imm_init.lang，避免 ImmortalWrt 的 99-default-settings 把语言改回 auto）
uci -q get system.@imm_init[0] >/dev/null || uci -q add system imm_init >/dev/null
uci -q batch <<'U'
set system.@system[0].hostname='XRouter'
set system.@system[0].log_size='128'
set system.@imm_init[0].lang='1'
set luci.main.lang='zh_cn'
commit system
commit luci
U

# 2. 网络：单网卡 eth0，静态地址；地址每次开机由 xrouter-net 按 cmdline 写入
uci -q batch <<'U'
delete network.wan
delete network.wan6
delete network.@device[0]
set network.lan=interface
set network.lan.proto='static'
set network.lan.device='eth0'
set network.lan.ipaddr='172.29.233.254'
set network.lan.netmask='255.255.255.0'
set network.lan.gateway='172.29.233.1'
delete network.lan.ip6assign
set network.vpn=interface
set network.vpn.proto='none'
set network.vpn.device='tun0'
commit network
set dhcp.lan.ignore='1'
delete dhcp.wan
commit dhcp
U

# 3. 防火墙：只保留 lan 和 vpn 两个分区（具名 section，xrouter-net 直接引用）
#    关闭 flow offloading / fullcone：自编内核未内建 nf_flow_table，flowtable 规则会导致整套规则加载失败
while uci -q delete firewall.@zone[0]; do :; done
while uci -q delete firewall.@forwarding[0]; do :; done
while uci -q delete firewall.@rule[0]; do :; done
while uci -q delete firewall.@redirect[0]; do :; done
uci -q batch <<'U'
set firewall.@defaults[0].flow_offloading='0'
set firewall.@defaults[0].flow_offloading_hw='0'
set firewall.@defaults[0].fullcone='0'
set firewall.@defaults[0].fullcone6='0'
set firewall.lan=zone
set firewall.lan.name='lan'
add_list firewall.lan.network='lan'
add_list firewall.lan.network='hotspot'
add_list firewall.lan.device='eth0'
set firewall.lan.input='ACCEPT'
set firewall.lan.output='ACCEPT'
set firewall.lan.forward='ACCEPT'
set firewall.lan.mtu_fix='1'
set firewall.vpn=zone
set firewall.vpn.name='vpn'
add_list firewall.vpn.network='vpn'
add_list firewall.vpn.device='tun+'
set firewall.vpn.input='REJECT'
set firewall.vpn.output='ACCEPT'
set firewall.vpn.forward='ACCEPT'
set firewall.vpn.masq='1'
set firewall.vpn.mtu_fix='1'
set firewall.lan_vpn=forwarding
set firewall.lan_vpn.src='lan'
set firewall.lan_vpn.dest='vpn'
set firewall.vpn_lan=forwarding
set firewall.vpn_lan.src='vpn'
set firewall.vpn_lan.dest='lan'
commit firewall
U

exit 0
