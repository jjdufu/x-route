#!/bin/sh
# XRouter: 虚拟机 IPv6 开关（由 xrouter-vpn 控制循环按手机侧 ipv6.cmd 调用）
#   xrouter-ipv6 on|off   修改 network.xr_eth0.ipv6 并立即生效（不重启虚拟机）
#   xrouter-ipv6 state    输出实际状态 1/0（以内核 eth0 的 disable_ipv6 为准）
DEV=eth0
state() {
  [ "$(cat /proc/sys/net/ipv6/conf/${DEV}/disable_ipv6 2>/dev/null)" = 0 ] && echo 1 || echo 0
}
apply() {
  v="$1"
  uci -q get network.xr_eth0 >/dev/null || { uci -q set network.xr_eth0=device; uci -q set network.xr_eth0.name="${DEV}"; }
  uci -q set network.xr_eth0.ipv6="$v"
  uci -q commit network
  /etc/init.d/network reload >/dev/null 2>&1
  # netifd 对已启用设备的 ipv6 变更不一定重新下发，这里直接写 sysctl 保证立即生效
  if [ "$v" = 1 ]; then d=0; else d=1; fi
  echo "$d" > "/proc/sys/net/ipv6/conf/${DEV}/disable_ipv6" 2>/dev/null
  [ "$v" = 1 ] && ifup lan >/dev/null 2>&1
  /etc/init.d/firewall reload >/dev/null 2>&1
  return 0
}
case "$1" in
  on) apply 1 ;;
  off) apply 0 ;;
  state) state ;;
  *) echo "usage: xrouter-ipv6 on|off|state"; exit 2 ;;
esac
