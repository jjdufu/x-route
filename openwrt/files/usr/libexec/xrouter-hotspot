#!/bin/sh
# XRouter: 热点交给 OpenWrt 分配地址（手机侧经控制目录 host/hotspot.cmd 下发，见 xrouter-vpn）
#   xrouter-hotspot on <网关CIDR> [+旧网关CIDR…] [已连设备IP…]
#                                                 eth1 用该网关地址起 DHCP（IPv6 开时再起 RA / DHCPv6）；
#                                                 网关是安卓热点原网关（跟随模式）或手机侧设定的固定网段；
#                                                 「+旧网关」：固定网段时保留安卓原网关为第二地址，已连设备续租前照常上网
#   xrouter-hotspot off                           释放 eth1（热点交还安卓）
#   xrouter-hotspot ipv6                          按当前 IPv6 开关刷新热点侧 IPv6（xrouter-ipv6 调用）
#   xrouter-hotspot status                        输出当前状态：on <CIDR> 或 off
# eth1 是虚拟机第二块网卡，手机侧 xr1 与热点网卡同在网桥 xrbr1 中。
DEV=eth1
ST=/tmp/xrouter.hotspot
ULA6="fd7a:7872:ea::1/64"

status() { cat "$ST" 2>/dev/null || echo off; }

# 网段地址：$1=IP $2=掩码长度
net_of() {
  o1=${1%%.*}; r=${1#*.}; o2=${r%%.*}; r=${r#*.}; o3=${r%%.*}; o4=${r#*.}
  a=$(( (o1 << 24) | (o2 << 16) | (o3 << 8) | o4 )); m=0; i=0
  while [ "$i" -lt 32 ]; do m=$(( m * 2 )); [ "$i" -lt "$2" ] && m=$(( m + 1 )); i=$((i + 1)); done
  a=$(( a & m ))
  echo "$(( (a >> 24) & 255 )).$(( (a >> 16) & 255 )).$(( (a >> 8) & 255 )).$(( a & 255 ))/$2"
}

v6_on() { [ "$(uci -q get network.xr_eth0.ipv6)" = 1 ]; }

apply_v6() {
  if v6_on; then
    echo 0 > "/proc/sys/net/ipv6/conf/${DEV}/disable_ipv6" 2>/dev/null
    uci -q batch <<U
set network.hotspot.ip6addr='${ULA6}'
set dhcp.hotspot.ra='server'
set dhcp.hotspot.dhcpv6='server'
set dhcp.hotspot.ra_default='2'
set dhcp.hotspot.ra_management='1'
U
  else
    uci -q batch <<'U'
delete network.hotspot.ip6addr
set dhcp.hotspot.ra='disabled'
set dhcp.hotspot.dhcpv6='disabled'
U
    echo 1 > "/proc/sys/net/ipv6/conf/${DEV}/disable_ipv6" 2>/dev/null
  fi
}

okcidr() { # 合法的 a.b.c.d/16~30
  case "$1" in *[!0-9./]*|*/*/*) return 1 ;; */*) ;; *) return 1 ;; esac
  l="${1#*/}"; case "$l" in ''|*[!0-9]*) return 1 ;; esac
  [ "$l" -ge 16 ] && [ "$l" -le 30 ] || return 1
  o="${1%/*}."; n=0
  while [ -n "$o" ]; do
    v="${o%%.*}"; o="${o#*.}"; n=$((n + 1))
    case "$v" in ''|*[!0-9]*) return 1 ;; esac
    [ "$v" -le 255 ] || return 1
  done
  [ "$n" = 4 ]
}

# fw4 伪装规则：$1=section $2=名称 $3=源网段（空则删除）。有改动返回 0
masq() {
  if [ -z "$3" ]; then
    uci -q get "firewall.$1" >/dev/null || return 1
    uci -q delete "firewall.$1"; return 0
  fi
  [ "$(uci -q get "firewall.$1.src_ip")" = "$3" ] && return 1
  uci -q batch <<U
set firewall.$1=nat
set firewall.$1.name='$2'
set firewall.$1.family='ipv4'
set firewall.$1.proto='all'
set firewall.$1.src='lan'
set firewall.$1.src_ip='$3'
set firewall.$1.device='eth0'
set firewall.$1.target='MASQUERADE'
U
  return 0
}

on() {
  cidr="$1"; shift
  [ -d "/sys/class/net/${DEV}" ] || { echo "err 无 ${DEV}" > "$ST"; return 1; }
  okcidr "$cidr" || { echo "err 网段无效" > "$ST"; return 1; }
  ip="${cidr%/*}"; len="${cidr#*/}"
  # 固定网段时手机侧附带的安卓原网关（+前缀），其余参数是已连设备 IP
  olds=""; clients=""
  for a in "$@"; do
    case "$a" in +*) okcidr "${a#+}" && olds="${olds} ${a#+}" ;; *) clients="${clients} $a" ;; esac
  done
  limit=$(( (1 << (32 - len)) - 3 )); [ "$limit" -gt 250 ] && limit=250
  # 第一个地址决定 DHCP 网段（dnsmasq 只为它发地址），旧网关只做第二地址
  uci -q batch <<U
set network.hotspot=interface
set network.hotspot.proto='static'
set network.hotspot.device='${DEV}'
set network.hotspot.auto='0'
delete network.hotspot.ipaddr
delete network.hotspot.netmask
add_list network.hotspot.ipaddr='${cidr}'
set dhcp.hotspot=dhcp
set dhcp.hotspot.interface='hotspot'
set dhcp.hotspot.start='2'
set dhcp.hotspot.limit='${limit}'
set dhcp.hotspot.leasetime='1h'
set dhcp.hotspot.force='1'
set dhcp.hotspot.dhcpv4='server'
set dhcp.@dnsmasq[0].authoritative='1'
U
  for o in $olds; do uci -q add_list network.hotspot.ipaddr="$o"; done
  apply_v6
  fwchg=0
  uci -q get firewall.lan.network | grep -qw hotspot || { uci -q add_list firewall.lan.network='hotspot'; fwchg=1; }
  # 热点设备不走 VPN 的流量（直连 / VPN 未连）从 eth0 出去时伪装成 VM 地址：
  # 手机侧只认 VM 网段（XR_NAT / XR_FWD），回包也就自然回到 OpenWrt，不会被安卓从热点网卡直接送回
  # 固定网段时，续租前仍用安卓原网段地址的设备同样伪装（第二条规则；跟随模式时删除）
  masq xr_hs_masq xrouter-hotspot-masq "$(net_of "$ip" "$len")" && fwchg=1
  osub=""; for o in $olds; do osub="$(net_of "${o%/*}" "${o#*/}")"; break; done
  masq xr_hs_masq_old xrouter-hotspot-masq-old "$osub" && fwchg=1
  uci -q commit network; uci -q commit dhcp; uci -q commit firewall
  ip link set "$DEV" up
  ifup hotspot >/dev/null 2>&1
  i=0
  while [ "$i" -lt 10 ]; do
    ip -4 addr show dev "$DEV" 2>/dev/null | grep -q " ${ip}/" && break
    sleep 1; i=$((i + 1))
  done
  ip -4 addr show dev "$DEV" 2>/dev/null | grep -q " ${ip}/" || { echo "err eth1 地址未生效" > "$ST"; return 1; }
  [ "$fwchg" = 1 ] && /etc/init.d/firewall reload >/dev/null 2>&1
  /etc/init.d/dnsmasq reload >/dev/null 2>&1
  /etc/init.d/odhcpd reload >/dev/null 2>&1
  echo "on ${cidr}" > "$ST"
  logger -t xrouter "热点网段 ${cidr} 由 OpenWrt 接管${olds:+（保留旧网关${olds}）}"
  # 已连设备：主动 ARP 一次，设备随即把网关 MAC 更新为 eth1（地址不变，无需重连）
  (
    if command -v arping >/dev/null 2>&1; then
      arping -U -c 2 -I "$DEV" "$ip" >/dev/null 2>&1
      for o in $olds; do arping -U -c 2 -I "$DEV" -s "${o%/*}" "${o%/*}" >/dev/null 2>&1; done
    fi
    for c in $clients; do ping -c 1 -W 1 -I "$DEV" "$c" >/dev/null 2>&1 & done
    wait
  ) &
  return 0
}

off() {
  fwchg=0
  masq xr_hs_masq "" "" && fwchg=1
  masq xr_hs_masq_old "" "" && fwchg=1
  if [ "$fwchg" = 1 ]; then
    uci -q commit firewall
    /etc/init.d/firewall reload >/dev/null 2>&1
  fi
  ifdown hotspot >/dev/null 2>&1
  ip -4 addr flush dev "$DEV" 2>/dev/null
  echo off > "$ST"
  logger -t xrouter "热点交还安卓"
}

case "$1" in
  on) shift; on "$@" ;;
  off) off ;;
  ipv6)
    uci -q get network.hotspot >/dev/null || exit 0
    apply_v6; uci -q commit network; uci -q commit dhcp
    case "$(status)" in on*) ifup hotspot >/dev/null 2>&1; /etc/init.d/odhcpd reload >/dev/null 2>&1 ;; esac
    ;;
  status) status ;;
  *) echo "usage: xrouter-hotspot on CIDR [IP…]|off|ipv6|status"; exit 2 ;;
esac
