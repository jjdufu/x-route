# ==============================================================================
# x-route: Gunyah pVM guest 内核配置片段（追加在 ImmortalWrt 25.12.2 官方 armsr/armv8 内核配置之后）
# ==============================================================================
# --- Gunyah pVM 必需 ---
CONFIG_DMA_RESTRICTED_POOL=y
CONFIG_SWIOTLB=y
CONFIG_PCI=y
CONFIG_PCI_HOST_GENERIC=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_HVC_DRIVER=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_ARM_PSCI_FW=y
CONFIG_ARM_GIC_V3=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_EXT4_FS=y
# CONFIG_VIRTIO_BALLOON is not set
# --- 共享目录 ---
CONFIG_FUSE_FS=y
CONFIG_VIRTIO_FS=y
# --- 路由（官方同为 y，这里显式固定）---
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IPV6_MULTIPLE_TABLES=y
# --- 网络功能模块保持与官方一致（=m）---
# netfilter / nftables / conntrack / tproxy / socket / TUN / inet_diag 等全部沿用官方 .config 的 =m，
# 由 ImageBuilder 安装官方 kmod-*。这样用户以后 apk add 任何官方 kmod（kmod-nft-tproxy、
# kmod-nft-socket、kmod-nft-fullcone、kmod-inet-diag ……）都与“原厂内核”行为一致：
# OpenWrt 的 kmodloader 只认 .ko 之间的依赖，若把依赖项改成内建，官方 .ko 会因“缺少依赖”无法 modprobe。
# --- 不需要 ---
# CONFIG_NET_9P is not set
# CONFIG_9P_FS is not set
# CONFIG_OVERLAY_FS is not set
# CONFIG_MODVERSIONS is not set
CONFIG_LOCALVERSION=""
# CONFIG_LOCALVERSION_AUTO is not set
# --- 构建：不嵌 initramfs，不生成调试信息 / BTF ---
CONFIG_INITRAMFS_SOURCE=""
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT is not set
# CONFIG_DEBUG_INFO_DWARF4 is not set
# CONFIG_DEBUG_INFO_DWARF5 is not set
# CONFIG_DEBUG_INFO_BTF is not set
