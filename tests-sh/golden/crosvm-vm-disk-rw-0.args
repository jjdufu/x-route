run
--hypervisor
gunyah
--protected-vm-without-firmware
--disable-sandbox
--no-balloon
--swiotlb
64
--cpus
2
--mem
768
--net
tap-name=xr0,mac=52:54:00:1d:e9:fe
--block
@T@/data/images/openwrt-rootfs.img,lock=false,root=true,ro=true
--serial
type=file,path=@T@/data/run/console.log,hardware=serial,num=1,console=true,earlycon=true
--serial
type=file,path=@T@/data/run/vm-ctl.log,hardware=virtio-console,num=1
--serial
type=unix-stream,hardware=virtio-console,num=2,path=@T@/data/run/clash-ctl.sock,input-unix-stream
--socket
@T@/data/run/crosvm.sock
--shared-dir
@T@/data/run/guest:xrctl:type=fs:cache=auto:timeout=0
--params
root=/dev/vda ro rootwait console=ttyS0,115200 earlycon panic=5 xr.ip=172.29.233.254/24 xr.gw=172.29.233.1 xr.dns=223.5.5.5,119.29.29.29 xr.ip6=fd7a:7872:e9::254/64 xr.gw6=fd7a:7872:e9::1 xr.share=off xr.time=@TIME@
@T@/data/images/Image
